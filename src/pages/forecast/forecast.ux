  margin-top: 3px;
}

.ic-sm {
  position: relative;
  width: 40px;
  height: 40px;
  margin-left: 8px;
}

/* 中：天气文字 + 降水/风力。flex-grow 吃掉剩下的宽度 */
.li-t {
  flex-direction: column;
  justify-content: center;
  flex-grow: 1;
  margin-left: 12px;
}
.li-c {
  font-size: 19px;
  color: #A9BDD4;
}
.li-pop {
  font-size: 14px;
  color: #5E7590;
  margin-top: 4px;
}

/* 右：高低温。固定宽度 + 右对齐，7 行的小数点才会对齐成一列 */
.li-r {
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  width: 92px;
}
.li-temp {
  font-size: 21px;
  color: #FFFFFF;
}

/* 空态：占满顶栏和底栏之间的全部空间 */
.empty {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 352px;
  margin-left: 40px;
  flex-grow: 1;
}
.empty-ic {
  font-size: 52px;
  color: #E8B65A;
}
.empty-t {
  font-size: 22px;
  color: #A9BDD4;
  text-align: center;
  margin-top: 14px;
}
.empty-s {
  font-size: 16px;
  color: #5E7590;
