}
.title {
  font-size: 24px;
  color: #FFFFFF;
}
.city {
  font-size: 18px;
  color: #6F87A3;
}

/* 列表吃掉顶栏/底栏之外的全部高度，不写死。
   写死的话真机上底栏会被裁掉 —— 可绘制区比屏幕矮 48px，见 index.ux 顶部注释。 */
.lst {
  width: 100%;
  flex-grow: 1;
}
.li {
  flex-direction: row;
  align-items: center;
  width: 384px;
  margin-left: 24px;
